<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.solomarket.dao.UserDao">

    <!-- ✅ 아이디 중복 검사 -->
    <select id="findById" parameterType="string" resultType="com.solomarket.dto.UserDto">
        SELECT * FROM tbl_user WHERE user_id = #{userId}
    </select>

    <!-- ✅ 닉네임 중복 검사 -->
    <select id="findByNick" parameterType="string" resultType="com.solomarket.dto.UserDto">
        SELECT * FROM tbl_user WHERE nickname = #{nickName}
    </select>

    <select id="findByUserId" resultType="com.solomarket.dto.UserDto">
        SELECT
            user_id AS userId,
            password,
            username,
            nickname,
            email,
            phone,
            birth,
            created_at AS createdAt,
            role,
            user_image AS userImage,
            gender
        FROM tbl_user
        WHERE user_id = #{userId}
    </select>

    <insert id="insertUser" parameterType="com.solomarket.dto.UserDto">
        INSERT INTO tbl_user VALUES
        (null, #{userId}, #{password}, #{userName},
        #{nickName}, #{email}, #{phone}, #{birth},
        #{createdAt}, #{role}, #{userImage}, #{gender}, 0, 'Y')
    </insert>



</mapper>