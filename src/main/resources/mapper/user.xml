<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.solomarket.dao.UserDao">

    <!-- ✅ 아이디 중복 검사 -->
    <select id="findById" parameterType="string" resultType="com.solomarket.dto.UserDto">
        SELECT * FROM tbl_user WHERE user_id = #{userId}
    </select>

    <!-- ✅ 닉네임 중복 검사 -->
    <select id="findByNick" parameterType="string" resultType="com.solomarket.dto.UserDto">
        SELECT * FROM tbl_user WHERE nickname = #{nickName}
    </select>

    <select id="findByUserId" resultType="com.solomarket.dto.UserDto">
        SELECT
            user_id,
            password,
            username,
            nickname,
            email,
            phone,
            birth,
            created_at,
            role,
            user_image,
            gender
        FROM tbl_user
        WHERE user_id = #{userId}
    </select>

    <insert id="insertUser" parameterType="com.solomarket.dto.UserDto">
        INSERT INTO tbl_user VALUES
        (null, #{userId}, #{password}, #{userName},
        #{nickName}, #{email}, #{phone}, #{birth},
        #{createdAt}, #{role}, #{userImage}, #{gender}, 0, 'Y')
    </insert>

    <!-- ✅ 이름 + 전화번호로 아이디 찾기 -->
    <select id="findByNameAndPhone" resultType="com.solomarket.dto.UserDto">
        SELECT * FROM tbl_user
        WHERE username = #{userName}
        AND phone = #{phone}
    </select>

    <!-- ✅ 아이디 + 전화번호 일치 확인 (비밀번호 찾기용) -->
    <select id="findByIdAndPhone" resultType="com.solomarket.dto.UserDto">
        SELECT * FROM tbl_user
        WHERE user_id = #{userId}
        AND phone = #{phone}
    </select>

    <!-- ✅ 임시 비밀번호로 비번 업데이트 -->
    <update id="updatePassword" parameterType="com.solomarket.dto.UserDto">
        UPDATE tbl_user
        SET password = #{password}
        WHERE user_id = #{userId}
    </update>

    <update id="updateUserNickAndPassword" parameterType="com.solomarket.dto.UserDto">
        UPDATE tbl_user
        SET
        nickname = #{nickName}
        <if test="password != null and password != ''">
            , password = #{password}
        </if>
        WHERE user_id = #{userId}
    </update>

</mapper>
